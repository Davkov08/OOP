#include<bits/stdc++.h>
using namespace std;
// +, -, *, /, ==, <, >
class Frac {
    int n;
    int d;
public:
    int N () const { return this->n; }
    int D () const { return this->d; }
    void setN(int x) { this->n = x; }
    void setD(int x) { this->d = x; }

    Frac(const int n, const int d=1) {
        this->n = n;
        this->d = d;
    }

    Frac (const Frac& orig) {
        this->n = orig.n;
        this->d = orig.d;
    }

    int gcd(int a, int b) {
        if (b == 0) return abs(a);
        return gcd(b, a % b);
    }

    void reduce() {
        int g = gcd(n, d);
        n /= g;
        d /= g;
        if (d < 0) {
            d = -d;
            n = -n;
        }
    }

    Frac& operator=(const Frac& orig) {
        if (this!=&orig) {
            this->n = orig.n;
            this->d = orig.d;
        }
        return *this;
    }

    Frac operator+(const Frac& b) const {
        Frac c(*this);

        if (this->D() % b.D() == 0) {
            c.setN(this->N() + b.N() * (this->D() / b.D()));
            c.setD(this->D());
        }
        else if (b.D() % this->D() == 0) {
            c.setN(this->N() * (b.D() / this->D()) + b.N());
            c.setD(b.D());
        }
        else {
            c.setN(this->N() * b.D() + b.N() * this->D());
            c.setD(this->D() * b.D());
        }

        c.reduce();
        return c;
    }

    Frac operator-(const Frac& b) const {
        Frac c(*this);

        if (this->D() % b.D() == 0) {
            c.setN(this->N() - b.N() * (this->D() / b.D()));
            c.setD(this->D());
        }
        else if (b.D() % this->D() == 0) {
            c.setN(this->N() * (b.D() / this->D()) - b.N());
            c.setD(b.D());
        }
        else {
            c.setN(this->N() * b.D() - b.N() * this->D());
            c.setD(this->D() * b.D());
        }

        c.reduce();
        return c;
    }

    Frac operator*(const Frac& b) const {
        Frac c(*this);
        c.setN(this->N() * b.N());
        c.setD(this->D() * b.D());
        c.reduce();
        return c;
    }

    Frac operator/(const Frac& b) const {
        Frac c(*this);
        c.setN(this->N() * b.D());
        c.setD(this->D() * b.N());
        c.reduce();
        return c;
    }

    bool operator==(const Frac& b) const {
        return (long long)this->N() * b.D() == (long long)b.N() * this->D();
    }

    bool operator<(const Frac& b) const {
        return (long long)this->N() * b.D() < (long long)b.N() * this->D();
    }

    bool operator>(const Frac& b) const {
        return (long long)this->N() * b.D() > (long long)b.N() * this->D();
    }

    void print() {
        cout<<this->n <<"/" << this->d;
    }

    ~Frac() {}
};

ostream& operator<<(ostream& o, const Frac& f) {
    o<<f.N() <<"/" << f.D();
    return o;
}

int main() {
    Frac a(2,15);
    Frac b(4,5);
    Frac c=a/b;
    c.print();
}
