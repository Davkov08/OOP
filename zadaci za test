#include <iostream>
#include <cstring>
using namespace std;

enum Tip { LINUX, UNIX, WINDOWS };

class OperativenSistem {
    char* ime;
    float verzija;
    Tip tip;
    float golemina;

    void copy(const OperativenSistem& o) {
        ime = new char[strlen(o.ime) + 1];
        strcpy(ime, o.ime);
        verzija = o.verzija;
        tip = o.tip;
        golemina = o.golemina;
    }

public:
    OperativenSistem() {
        ime = new char[1];
        ime[0] = '\0';
        verzija = 0;
        tip = LINUX;
        golemina = 0;
    }

    OperativenSistem(const char* i, float v, Tip t, float g) {
        ime = new char[strlen(i) + 1];
        strcpy(ime, i);
        verzija = v;
        tip = t;
        golemina = g;
    }

    OperativenSistem(const OperativenSistem& o) {
        copy(o);
    }

    ~OperativenSistem() {
        delete[] ime;
    }

    OperativenSistem& operator=(const OperativenSistem& o) {
        if (this != &o) {
            delete[] ime;
            copy(o);
        }
        return *this;
    }

    bool ednakviSe(const OperativenSistem& o) const {
        return strcmp(ime, o.ime) == 0 &&
               verzija == o.verzija &&
               tip == o.tip &&
               golemina == o.golemina;
    }

    int sporediVerzija(const OperativenSistem& o) const {
        if (verzija == o.verzija) return 0;
        if (o.verzija > verzija) return -1;
        return 1;
    }

    bool istaFamilija(const OperativenSistem& o) const {
        return strcmp(ime, o.ime) == 0 && tip == o.tip;
    }

    void pecati() const {
        cout << "OS: " << ime << " Version: " << verzija << " Type: ";
        if (tip == LINUX) cout << "LINUX";
        else if (tip == UNIX) cout << "UNIX";
        else cout << "WINDOWS";
        cout << " Size: " << golemina << "GB" << endl;
    }
};

class Repozitorium {
    char ime[20];
    OperativenSistem* sistemi;
    int n;

public:
    Repozitorium(const char* i) {
        strcpy(ime, i);
        sistemi = nullptr;
        n = 0;
    }

    ~Repozitorium() {
        delete[] sistemi;
    }

    void dodadi(const OperativenSistem& nov) {
        for (int i = 0; i < n; i++) {
            if (sistemi[i].istaFamilija(nov)) {
                if (sistemi[i].sporediVerzija(nov) == -1) {
                    sistemi[i] = nov;
                    return;
                }
            }
        }
        OperativenSistem* temp = new OperativenSistem[n + 1];
        for (int i = 0; i < n; i++)
            temp[i] = sistemi[i];
        temp[n] = nov;
        delete[] sistemi;
        sistemi = temp;
        n++;
    }

    void izbrishi(const OperativenSistem& os) {
        for (int i = 0; i < n; i++) {
            if (sistemi[i].ednakviSe(os)) {
                OperativenSistem* temp = new OperativenSistem[n - 1];
                int idx = 0;
                for (int j = 0; j < n; j++) {
                    if (j != i)
                        temp[idx++] = sistemi[j];
                }
                delete[] sistemi;
                sistemi = temp;
                n--;
                return;
            }
        }
    }

    void pecatiOperativniSistemi() const {
        cout << "Repository: " << ime << endl;
        for (int i = 0; i < n; i++)
            sistemi[i].pecati();
    }
};
int main() {
    OperativenSistem os1("Ubuntu", 20.04, LINUX, 4.5);
    OperativenSistem os2("Ubuntu", 22.04, LINUX, 5.0);
    OperativenSistem os3("Windows", 10, WINDOWS, 15.0);
    OperativenSistem os4("Windows", 11, WINDOWS, 18.0);
    OperativenSistem os5("Ubuntu", 20.04, LINUX, 4.5);

    Repozitorium repo("FINKI-Cloud");

    repo.dodadi(os1);
    repo.dodadi(os3);

    cout << "Initial repository:" << endl;
    repo.pecatiOperativniSistemi();
    cout << endl;

    repo.dodadi(os2);

    cout << "After adding newer Ubuntu:" << endl;
    repo.pecatiOperativniSistemi();
    cout << endl;

    repo.dodadi(os4);

    cout << "After adding Windows 11:" << endl;
    repo.pecatiOperativniSistemi();
    cout << endl;

    repo.izbrishi(os5);

    cout << "After deleting Ubuntu 20.04:" << endl;
    repo.pecatiOperativniSistemi();

    return 0;
}
