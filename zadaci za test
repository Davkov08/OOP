#include <iostream>
#include <cstring>
using namespace std;

enum Extension { txt, pdf, exe };

class File {
    char* name;
    Extension ext;
    char* owner;
    int size;

    void copy(const File& f) {
        name = new char[strlen(f.name) + 1];
        strcpy(name, f.name);

        owner = new char[strlen(f.owner) + 1];
        strcpy(owner, f.owner);

        ext = f.ext;
        size = f.size;
    }

public:
    File() {
        name = new char[1];
        name[0] = '\0';
        owner = new char[1];
        owner[0] = '\0';
        ext = txt;
        size = 0;
    }

    File(const char* n, Extension e, const char* o, int s) {
        name = new char[strlen(n) + 1];
        strcpy(name, n);

        owner = new char[strlen(o) + 1];
        strcpy(owner, o);

        ext = e;
        size = s;
    }

    File(const File& f) {
        copy(f);
    }

    ~File() {
        delete[] name;
        delete[] owner;
    }

    File& operator=(const File& f) {
        if (this != &f) {
            delete[] name;
            delete[] owner;
            copy(f);
        }
        return *this;
    }

    bool equals(const File& f) const {
        return strcmp(name, f.name) == 0 &&
               strcmp(owner, f.owner) == 0 &&
               ext == f.ext;
    }

    bool equalsType(const File& f) const {
        return strcmp(name, f.name) == 0 &&
               ext == f.ext;
    }

    void print() const {
        cout << name << ".";
        if (ext == txt) cout << "txt";
        else if (ext == pdf) cout << "pdf";
        else cout << "exe";
        cout << " " << owner << " " << size << "MB" << endl;
    }
};

class Folder {
    char* name;
    int count;
    File* files;

public:
    Folder(const char* n) {
        name = new char[strlen(n) + 1];
        strcpy(name, n);
        count = 0;
        files = nullptr;
    }

    ~Folder() {
        delete[] name;
        delete[] files;
    }

    void add(const File& f) {
        File* temp = new File[count + 1];
        for (int i = 0; i < count; i++)
            temp[i] = files[i];
        temp[count] = f;
        delete[] files;
        files = temp;
        count++;
    }

    void remove(const File& f) {
        for (int i = 0; i < count; i++) {
            if (files[i].equals(f)) {
                File* temp = new File[count - 1];
                int idx = 0;
                for (int j = 0; j < count; j++) {
                    if (j != i)
                        temp[idx++] = files[j];
                }
                delete[] files;
                files = temp;
                count--;
                return;
            }
        }
    }

    void print() const {
        cout << "Folder: " << name << endl;
        for (int i = 0; i < count; i++)
            files[i].print();
    }
};
int main() {
    File f1("document", txt, "Jovan", 5);
    File f2("book", pdf, "Ana", 12);
    File f3("program", exe, "Marko", 20);
    File f4("document", txt, "Jovan", 5);
    File f5("document", txt, "Petar", 8);

    Folder folder("MyFolder");

    folder.add(f1);
    folder.add(f2);
    folder.add(f3);

    cout << "Initial folder content:" << endl;
    folder.print();
    cout << endl;

    cout << "Testing equals (f1 vs f4): ";
    cout << (f1.equals(f4) ? "true" : "false") << endl;

    cout << "Testing equals (f1 vs f5): ";
    cout << (f1.equals(f5) ? "true" : "false") << endl;

    cout << "Testing equalsType (f1 vs f5): ";
    cout << (f1.equalsType(f5) ? "true" : "false") << endl;

    cout << "Removing f1..." << endl;
    folder.remove(f1);

    cout << "Folder content after remove:" << endl;
    folder.print();
    cout << endl;

    cout << "Adding f4..." << endl;
    folder.add(f4);

    cout << "Final folder content:" << endl;
    folder.print();

    return 0;
}
