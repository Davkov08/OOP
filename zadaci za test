#include <bits/stdc++.h>
using namespace std;

class IceCream {
private:
    char* name;                 
    char composition[101];     
    double price;
    int discount;               

    void copyName(const char* src) {
        delete[] name;
        name = new char[strlen(src) + 1];
        strcpy(name, src);
    }

public:
    IceCream() {
        name = new char[1];
        name[0] = '\0';
        composition[0] = '\0';
        price = 0;
        discount = 0;
    }

    IceCream(const char* n, const char* comp, double p, int d = 0) {
        name = new char[1];     // за да може delete[] во copyName
        name[0] = '\0';
        copyName(n);

        strncpy(composition, comp, 100);
        composition[100] = '\0';

        price = p;
        discount = d;
    }

    IceCream(const IceCream& other) {
        name = new char[1];
        name[0] = '\0';
        copyName(other.name);

        strcpy(composition, other.composition);
        price = other.price;
        discount = other.discount;
    }

    IceCream& operator=(const IceCream& other) {
        if (this != &other) {
            copyName(other.name);
            strcpy(composition, other.composition);
            price = other.price;
            discount = other.discount;
        }
        return *this;
    }

    ~IceCream() {
        delete[] name;
    }

    IceCream& operator++() {
        discount += 5;
        if (discount > 100) discount = 100;
        return *this;
    }

    IceCream operator+(const char* extra) const {
        char newName[1024];
        strcpy(newName, name);
        strcat(newName, " + ");
        strcat(newName, extra);

        IceCream result(newName, composition, price + 10, discount);
        return result;
    }

    void setDiscount(int d) {
        if (d >= 0 && d <= 100) {
            discount = d;
        }
    }

    void setName(const char* n) {
        copyName(n);
    }

    friend ostream& operator<<(ostream& os, const IceCream& ice) {
        os << ice.name << ": " << ice.composition << " ";
        os << fixed << setprecision(2) << ice.price;

        if (ice.discount > 0) {
            double discounted =
                ice.price * (100 - ice.discount) / 100.0;
            os << " [" << fixed << setprecision(2) << discounted << "]";
        }
        return os;
    }
};

class IceCreamShop {
private:
    char shopName[51];
    IceCream* arr;
    int count;

    void resize() {
        IceCream* tmp = new IceCream[count + 1];
        for (int i = 0; i < count; i++) {
            tmp[i] = arr[i];
        }
        delete[] arr;
        arr = tmp;
    }

public:
    IceCreamShop() {
        shopName[0] = '\0';
        arr = nullptr;
        count = 0;
    }

    IceCreamShop(const char* name) {
        strncpy(shopName, name, 50);
        shopName[50] = '\0';
        arr = nullptr;
        count = 0;
    }

    ~IceCreamShop() {
        delete[] arr;
    }

    IceCreamShop& operator+=(const IceCream& ice) {
        resize();
        arr[count] = ice;
        count++;
        return *this;
    }

    friend ostream& operator<<(ostream& os, const IceCreamShop& shop) {
        os << shop.shopName << endl;
        for (int i = 0; i < shop.count; i++) {
            os << shop.arr[i] << endl;
        }
        return os;
    }
};

int main() {
    IceCream ice1("Vanilla", "milk, sugar, vanilla", 2.5);
    IceCream ice2("Chocolate", "cocoa, milk, sugar", 3.0, 10);

    cout << ice1 << endl;
    cout << ice2 << endl;

    ++ice2;
    cout << ice2 << endl;

    IceCream ice3 = ice1 + "with nuts";
    cout << ice3 << endl;

    ice3.setDiscount(20);
    ice3.setName("Special Vanilla");
    cout << ice3 << endl;

    IceCreamShop shop("Sweet Corner");
    shop += ice1;
    shop += ice2;
    shop += ice3;

    cout << shop << endl;

    return 0;
}
